{
  "name": "portfolio",
  "version": "5.0.0",
  "private": true,
  "homepage": "https://www.simontaggart.com",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:SiTaggart/PortfolioSite.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint './**/*.{js,jsx,ts,tsx}' --format codeframe",
    "prettier": "prettier -l '**/*.{js,jsx,ts,tsx,json,md,yml,yaml}'",
    "prettier:fix": "prettier --write '**/*.{js,jsx,ts,tsx,json,md,yml,yaml}'",
    "smoke": "bun run scripts/smoke-routes.ts",
    "test": "bun run smoke",
    "ci:checks": "bun run build && bun run lint && bun run prettier && bun run smoke",
    "cypress": "start-server-and-test 'bun run dev -- --host 127.0.0.1 --port 3000' http://127.0.0.1:3000 'bun run cypress:open'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:ci": "start-server-and-test 'bun run dev -- --host 127.0.0.1 --port 3000' http://127.0.0.1:3000 'bun run cypress:run'"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.36.4",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "@twilio-paste/core": "21.5.0",
    "@vitejs/plugin-react": "6.0.1",
    "lodash.reverse": "4.0.1",
    "lodash.sortby": "4.7.0",
    "prismjs": "1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-prism-plus": "2.0.2",
    "remark-gfm": "4.0.1",
    "vite": "8.0.12",
    "wrangler": "4.90.1"
  },
  "devDependencies": {
    "@sitaggart/eslint-config-ts": "0.7.0",
    "@sitaggart/prettier-config": "0.3.25",
    "@types/bun": "^1.3.13",
    "@types/lodash.reverse": "4.0.9",
    "@types/lodash.sortby": "4.7.9",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cypress": "15.15.0",
    "eslint": "8.57.1",
    "eslint-formatter-codeframe": "7.32.2",
    "prettier": "3.8.3",
    "start-server-and-test": "3.0.4",
    "typescript": "6.0.3"
  },
  "browserslist": [
    "defaults"
  ],
  "packageManager": "bun@1.3.13"
}
