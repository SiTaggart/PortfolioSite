{
  "name": "portfolio",
  "version": "6.0.0",
  "private": true,
  "homepage": "https://www.simontaggart.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:SiTaggart/PortfolioSite.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && bun run typecheck",
    "check": "npm-run-all --parallel typecheck lint format:check",
    "cf-typegen": "wrangler types",
    "cypress": "start-server-and-test 'bun run preview -- --host 127.0.0.1 --port 4173 --strictPort' http://127.0.0.1:4173 'bun run cypress:open'",
    "cypress:ci": "start-server-and-test 'bun run preview -- --host 127.0.0.1 --port 4173 --strictPort' http://127.0.0.1:4173 'bun run cypress:run'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "preview": "vite preview",
    "smoke": "bun run build && bun run smoke:routes",
    "smoke:routes": "bun run scripts/smoke-routes.ts",
    "test": "bun run smoke",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-start": "1.168.25",
    "clsx": "2.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.0",
    "@nkzw/oxlint-config": "1.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.2",
    "cypress": "15.16.0",
    "npm-run-all2": "9.0.1",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "start-server-and-test": "3.0.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.98.0"
  },
  "browserslist": [
    "defaults"
  ],
  "packageManager": "bun@1.3.14"
}
